{
  "name": "open-exchange",
  "version": "0.2.1",
  "description": "The Open Exchange: an application host on skein's host — the swap instance's facts materialized as token instances (shruggr/open-exchange#1, shruggr/skein#164). Runs with node alone: skein's host loads its kernel as wasm.",
  "type": "module",
  "bin": {
    "open-exchange": "./bin/open-exchange.js"
  },
  "files": [
    "dist",
    "bin/open-exchange.js",
    "image",
    "apps",
    "README.md"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "prepack": "npm run build",
    "typecheck": "tsc -p tsconfig.json",
    "accept": "node --experimental-strip-types --no-warnings scripts/accept/ox-accept.ts"
  },
  "dependencies": {
    "@dcasegr/skein": "0.1.1"
  },
  "devDependencies": {
    "typescript": "^7.0.2",
    "@types/node": "^26.6.2"
  },
  "engines": {
    "node": ">=24"
  },
  "license": "MIT"
}
